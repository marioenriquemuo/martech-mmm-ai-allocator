  "cards": [
    {
      "dot": "cyan",
      "title": "Client wall",
      "items": [
        "Default client is pathc. No flag still uses today's files.",
        "pathc keeps data/raw, data/processed, and reports.",
        "wellness uses only data/clients/wellness/.",
        "Industry separation is this wall, not a second model."
      ]
    },
    {
      "dot": "amber",
      "title": "Date-level controls",
      "items": [
        "One row per date. Do not sum across channels.",
        "Quincena is day 15 or the last calendar day.",
        "CSV or in-memory frames, not a live API.",
        "Brand search can be a mediator. Inventory can be a result of demand."
      ]
    },
    {
      "dot": "rose",
      "title": "Not in the fit",
      "items": [
        "Meridian reads the post-QA spend panel only.",
        "GAP-501-MODEL and GAP-501-API stay open.",
        "GAP-201-RANK stays open."
      ]
    },
    {
      "dot": "orange",
      "title": "Calibration gate",
      "items": [
        "Runs only when the spike is given --calibration.",
        "Pass: national roi bounds become log-normal roi_m.",
        "Fail: exit 1 before sample_prior. No model is built.",
        "A bogota row does not move the national prior.",
        "Omit the flag to keep PriorDistribution()."
      ]
    },
    {
      "dot": "emerald",
      "title": "What the numbers are",
      "items": [
        "Incremental KPI, not revenue dollars.",
        "baseline_sales stays on the spend panel."
      ]
    }
  ]
